# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=generate-a-random-32-char-string

# Database
DATABASE_URL="file:./dev.db"

# GitHub App (create at https://github.com/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_SLUG=your-app-slug
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# GitHub App URLs to configure in app settings:
#   Callback URL:  {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
#   Setup URL:     {NEXT_PUBLIC_APP_URL}/api/auth/install/callback
#   Webhook URL:   {NEXT_PUBLIC_APP_URL}/api/webhooks/github  (optional for MVP)

# Web Push (run: npm run generate-vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron protection (optional)
CRON_SECRET=
